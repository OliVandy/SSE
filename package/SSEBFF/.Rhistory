# Prioritize socioeconomic predictors
preferred_vars = grep(
"educ|school|poverty|income|unemp|employ|segreg",
candidate_vars,
value = TRUE,
ignore.case = TRUE)
# Remove variables without sufficient usable variation
usable = function(v) {
x = train_data[[v]]
sum(is.finite(x)) > 10 &&
length(unique(x[is.finite(x)])) > 1
}
preferred_vars = preferred_vars[
sapply(preferred_vars, usable)
]
candidate_vars = candidate_vars[
sapply(candidate_vars, usable)
]
# Select five variables, using remaining available
# numeric predictors if necessary
selected_vars = head(
unique(c(preferred_vars, candidate_vars)),
5)
if (length(selected_vars) < 3) {
stop("Fewer than three suitable predictors found.")
}
selected_vars
# Construct grouped-binomial counts
train_data = train_data %>%
mutate(
successes = round(p.upmover * N.lowstart),
failures = round(N.lowstart) - successes
)
# Construct the model formula
full_formula = as.formula(
paste(
"cbind(successes, failures) ~",
paste(selected_vars, collapse = " + ")
)
)
full_model = glm(
formula = full_formula,
data = train_data,
family = binomial(link = "logit"),
na.action = na.omit
)
summary(full_model)
View(chettyetal14)
# Model data after missing-value removal
complete_model_data = model.frame(full_model)
# Original number of training observations
n_original = nrow(train_data)
# Number of observations used in the regression
n_used = nrow(complete_model_data)
# Number excluded
n_excluded = n_original - n_used
missing_results = data.frame(
Description = c(
"Original training observations",
"Observations used in full model",
"Observations excluded"
),
Count = c(
n_original,
n_used,
n_excluded
)
)
print(missing_results, row.names = FALSE)
