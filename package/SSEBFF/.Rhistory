dat = read.delim("https://dept.stat.lsa.umich.edu/~bbh/s485/data/H5N1.tsv")
dat = dat[complete.cases(dat[, c("Fatal", "Age", "Gender")]), ]
# Ensure Fatal is coded 0/1
y = tolower(trimws(as.character(dat$Fatal)))
fatal_yes = c("1", "yes", "y", "true", "fatal", "died")
fatal_no = c("0", "no", "n", "false", "nonfatal",
"non-fatal", "survived")
stopifnot(all(y %in% c(fatal_yes, fatal_no)))
dat$Fatal = as.integer(y %in% fatal_yes)
dat$Gender = factor(dat$Gender)
m1 = glm(Fatal ~ Age + Gender, data = dat,
family = binomial(link = "logit"))
summary(m1)
knot = median(dat$Age)
# Construct degree-2 truncated power basis
dat$Age2 = dat$Age^2
dat$tp = pmax(dat$Age - knot, 0)^2
m2 = glm(Fatal ~ Age + Gender + Age2 + tp, data = dat,
family = binomial(link = "logit"))
summary(m2)
library(boot)
set.seed(485)
cv1 = cv.glm(dat, m1, K = 10)
set.seed(485)
cv2 = cv.glm(dat, m2, K = 10)
cv_errors = data.frame(
Model = c("Ordinary logistic", "Spline logistic"),
CV_Error = c(cv1$delta[1], cv2$delta[1]))
print(cv_errors)
# Determine whether the spline improved prediction
if (cv2$delta[1] < cv1$delta[1]) {
cat("The spline model has lower estimated generalization error.")
} else {
cat("The spline model does not improve estimated generalization error.")
}
knitr::opts_chunk$set(echo = TRUE)
alpha = 0.05
# Prepare the same observations for all model comparisons
vars = c("p.upmover", "N.lowstart", "Income",
"Seg_poverty", "Test_scores",
"Social_capital", "Single_mothers")
prepare_data = function(d) {
d = d[complete.cases(d[, vars]), ]
d = d[d$N.lowstart > 0, ]
n = round(d$N.lowstart)
d$successes = round(d$p.upmover * n)
d$failures = n - d$successes
return(d)
}
train = prepare_data(train_data)
fullmod_dat = model.frame(fit_full)
alpha = 0.05
m_initial = glm(
cbind(successes, failures) ~
Income + Seg_poverty + Test_scores + Single_mothers,
data = train, family = binomial())
source_file = if (file.exists("Mobility.csv")) {
"Mobility.csv"
} else {
"https://dept.stat.lsa.umich.edu/~bbh/s485/data/Mobility.csv"
}
mobility = read.csv(source_file)
selected_vars = c("Income", "Seg_poverty", "Test_scores",
"Social_capital", "Single_mothers")
required = c("p.upmover", "N.child", "prop.lowstart", selected_vars)
missing_cols = setdiff(required, names(mobility))
if (length(missing_cols) > 0) {
stop(paste("Missing Mobility.csv columns:",
paste(missing_cols, collapse = ", "),
"\nAvailable columns:", paste(names(mobility), collapse = ", ")))
}
# Fixed training/test split from the previous exercise (seed 485).
# All variable selection below uses ONLY the training partition.
set.seed(485)
train_rows = sample(seq_len(nrow(mobility)),
size = floor(nrow(mobility) / 2))
prepare_mobility = function(d) {
d = d[complete.cases(d[, required]), , drop = FALSE]
# The source variables are proportions; use an integer number of trials.
d$N.lowstart = round(d$N.child * d$prop.lowstart)
d = d[is.finite(d$N.lowstart) & d$N.lowstart > 0 &
is.finite(d$p.upmover) & d$p.upmover >= 0 &
d$p.upmover <= 1, , drop = FALSE]
d$successes = round(d$p.upmover * d$N.lowstart)
d$failures = d$N.lowstart - d$successes
d
}
train = prepare_mobility(mobility[train_rows, , drop = FALSE])
test = prepare_mobility(mobility[-train_rows, , drop = FALSE])
stopifnot(nrow(train) > 10, nrow(test) > 10)
cat("Training areas:", nrow(train), "; test areas:", nrow(test), "\n")
alpha = 0.05
m_initial = glm(
cbind(successes, failures) ~
Income + Seg_poverty + Test_scores + Single_mothers,
data = train, family = binomial())
summary(m_initial)
# Candidate main-effect deletions, for reference.
drop1(m_initial, test = "Chisq")
# All comparisons are made on the same complete-case training sample.
refine_round = function(fit, round_number, attempted = character()) {
pcoef = coef(summary(fit))[-1, "Pr(>|z|)"]
weak_n = sum(pcoef >= alpha, na.rm = TRUE)
current_terms = attr(terms(fit), "term.labels")
if (weak_n >= 2) {
# Prune the eligible term with the largest deletion-test p-value.
deletion = drop1(fit, test = "Chisq")
eligible = setdiff(rownames(deletion), "<none>")
eligible = eligible[is.finite(deletion[eligible, "Pr(>Chi)"])]
eligible = eligible[!(paste0("remove:", eligible) %in% attempted)]
if (!length(eligible)) {
cat("Round", round_number, ": no further eligible deletion.\n")
return(list(fit = fit, attempted = attempted))
}
term = eligible[which.max(deletion[eligible, "Pr(>Chi)"])]
smaller = update(fit, as.formula(paste(". ~ . -", term)))
larger = fit
action = "remove"
} else {
# Pre-specified, scientifically interpretable candidate interactions.
options = c("Income:Test_scores", "Seg_poverty:Single_mothers",
"Income:Seg_poverty", "Test_scores:Single_mothers")
possible = options[vapply(strsplit(options, ":"),
function(x) all(x %in% current_terms),
logical(1))]
possible = possible[!possible %in% current_terms]
possible = possible[!(paste0("add:", possible) %in% attempted)]
if (!length(possible)) {
cat("Round", round_number, ": no further eligible interaction.\n")
return(list(fit = fit, attempted = attempted))
}
term = possible[1]
smaller = fit
larger = update(fit, as.formula(paste(". ~ . +", term)))
action = "add"
}
lrt = anova(smaller, larger, test = "Chisq")
p = lrt$`Pr(>Chi)`[2]
chosen = if (is.finite(p) && p < alpha) larger else smaller
cat("\nRound", round_number, "- propose to", action, term,
"; LRT p =", format.pval(p, digits = 3), "\n")
print(lrt)
cat("Selected formula:", deparse(formula(chosen)), "\n")
list(fit = chosen, attempted = c(attempted, paste0(action, ":", term)),
action = action, term = term, p = p)
}
round1 = refine_round(m_initial, round_number = 1)
round2 = refine_round(round1$fit, round_number = 2,
attempted = round1$attempted)
M0 = round2$fit
cat("\nFinal M0, excluding social capital:\n")
formula(M0)
summary(M0)
# Add Social_capital as a main effect
M1_main = update(M0, . ~ . + Social_capital)
# Choose an existing control variable for interaction
controls = c("Income", "Test_scores",
"Seg_poverty", "Single_mothers")
available = intersect(
controls, attr(terms(M0), "term.labels"))
if (length(available) > 0) {
int_term = paste0("Social_capital:", available[1])
M1_int = update(
M1_main,
as.formula(paste(". ~ . +", int_term)))
# Test whether the interaction improves fit
lrt_int = anova(M1_main, M1_int, test = "Chisq")
print(lrt_int)
p_int = lrt_int$`Pr(>Chi)`[2]
M1 = if (!is.na(p_int) && p_int < alpha) {
M1_int
} else {
M1_main
}
} else {
M1 = M1_main
}
formula(M1)
M0_test = glm(
formula(M0),
data = test,
family = binomial(link = "logit")
)
M1_test = glm(
formula(M1),
data = test,
family = binomial(link = "logit")
)
final_lrt = anova(M0_test, M1_test, test = "Chisq")
print(final_lrt)
p_final = final_lrt$`Pr(>Chi)`[2]
cat("\nFinal test p-value:", p_final, "\n")
if (p_final < alpha) {
cat("Reject H0: Social capital provides significant",
"additional explanatory power for upward mobility.\n")
} else {
cat("Fail to reject H0: There is insufficient evidence",
"that social capital adds explanatory power.\n")
}
M0_test = glm(
formula(M0),
data = test,
family = binomial(link = "logit")
)
M1_test = glm(
formula(M1),
data = test,
family = binomial(link = "logit")
)
final_lrt = anova(M0_test, M1_test, test = "Chisq")
print(final_lrt)
p_final = final_lrt$`Pr(>Chi)`[2]
cat("\nFinal test p-value:", p_final, "\n")
library(Matrix)
library(glmnet)
dat = read.csv(
"https://dept.stat.lsa.umich.edu/~bbh/s485/data/d1-w-soccer-2026-no-post.csv",
check.names = FALSE
)
pick = function(options) {
clean = function(x) gsub("[^a-z0-9]", "", tolower(x))
i = match(clean(options), clean(names(dat)))
i = i[!is.na(i)]
if (length(i)) names(dat)[i[1]] else NULL
}
wc = pick(c("winner", "winning_team", "winningteam",
"winteam", "wteam"))
lc = pick(c("loser", "losing_team", "losingteam",
"loseteam", "lteam"))
if (!is.null(wc) && !is.null(lc)) {
winner = as.character(dat[[wc]])
loser = as.character(dat[[lc]])
} else {
tc1 = pick(c("home_team", "home", "team1", "team"))
tc2 = pick(c("away_team", "away", "visitor",
"opponent", "team2"))
sc1 = pick(c("home_score", "home_goals",
"team1score", "score1", "goals_for"))
sc2 = pick(c("away_score", "away_goals",
"team2score", "score2", "goals_against"))
rc = pick(c("result", "outcome", "wl"))
if (is.null(tc1) || is.null(tc2)) {
stop(paste("Check dataset columns:",
paste(names(dat), collapse = ", ")))
}
a = as.character(dat[[tc1]])
b = as.character(dat[[tc2]])
if (!is.null(sc1) && !is.null(sc2)) {
g1 = as.numeric(dat[[sc1]])
g2 = as.numeric(dat[[sc2]])
winner = ifelse(g1 > g2, a,
ifelse(g2 > g1, b, NA))
loser = ifelse(g1 > g2, b,
ifelse(g2 > g1, a, NA))
} else if (!is.null(rc)) {
r = toupper(trimws(as.character(dat[[rc]])))
winner = ifelse(r %in% c("W", "WIN"), a,
ifelse(r %in% c("L", "LOSS"), b, NA))
loser = ifelse(r %in% c("W", "WIN"), b,
ifelse(r %in% c("L", "LOSS"), a, NA))
} else {
stop(paste("Cannot identify results:",
paste(names(dat), collapse = ", ")))
}
}
library(Matrix)
library(glmnet)
dat = read.csv(
"https://dept.stat.lsa.umich.edu/~bbh/s485/data/d1-w-soccer-2026-no-post.csv",
check.names = FALSE
)
teams = setdiff(names(dat), c("home_win", "date"))
X = as.matrix(dat[, teams, drop = FALSE])
storage.mode(X) = "double"
y = as.numeric(as.character(dat$home_win))
# Keep valid win/loss games
keep = y %in% c(0, 1) &
rowSums(X == 1, na.rm = TRUE) == 1 &
rowSums(X == -1, na.rm = TRUE) == 1 &
rowSums(!is.finite(X)) == 0
X = X[keep, , drop = FALSE]
y = y[keep]
X = X[, colSums(abs(X)) > 0, drop = FALSE]
teams = colnames(X)
T = length(teams)
fit1 = glm.fit(
x = X[, -T, drop = FALSE],
y = y,
family = binomial(),
intercept = FALSE
)
set.seed(485)
fit2 = cv.glmnet(
x = Matrix(X, sparse = TRUE),
y = y,
family = "binomial",
alpha = 0,
intercept = FALSE,
standardize = FALSE,
nfolds = 10
)
library(Matrix)
library(glmnet)
dat = read.csv(
"https://dept.stat.lsa.umich.edu/~bbh/s485/data/d1-w-soccer-2026-no-post.csv",
check.names = FALSE
)
teams = setdiff(names(dat), c("home_win", "date"))
X = as.matrix(dat[, teams, drop = FALSE])
storage.mode(X) = "double"
y = as.numeric(as.character(dat$home_win))
# Keep valid win/loss games
keep = y %in% c(0, 1) &
rowSums(X == 1, na.rm = TRUE) == 1 &
rowSums(X == -1, na.rm = TRUE) == 1 &
rowSums(!is.finite(X)) == 0
X = X[keep, , drop = FALSE]
y = y[keep]
X = X[, colSums(abs(X)) > 0, drop = FALSE]
teams = colnames(X)
T = length(teams)
fit1 = glm.fit(
x = X[, -T, drop = FALSE],
y = y,
family = binomial(),
intercept = FALSE
)
set.seed(485)
fit2 = cv.glmnet(
x = Matrix(X, sparse = TRUE),
y = y,
family = "binomial",
alpha = 0,
intercept = FALSE,
standardize = FALSE,
nfolds = 10
)
beta1 = c(as.numeric(fit1$coefficients), 0)
beta2 = as.numeric(coef(fit2, s = "lambda.min"))[-1]
if (any(!is.finite(beta1)) || any(!is.finite(beta2))) {
stop("Non-finite team ratings; check for separation or disconnected teams.")
}
# Center strengths at zero
beta1 = beta1 - mean(beta1)
beta2 = beta2 - mean(beta2)
# Clean dataset of team strengths
strengths = data.frame(
Team = teams,
Ordinary_BT = beta1,
Ridge_BT = beta2
)
strengths$Rank_Ordinary = rank(
-strengths$Ordinary_BT, ties.method = "min")
strengths$Rank_Ridge = rank(
-strengths$Ridge_BT, ties.method = "min")
strengths$Rank_Difference =
strengths$Rank_Ridge - strengths$Rank_Ordinary
strengths = strengths[
order(strengths$Rank_Ordinary), ]
knitr::kable(head(strengths, 10), digits = 3)
rho = cor(
strengths$Rank_Ordinary,
strengths$Rank_Ridge,
method = "spearman")
cat("Spearman rank correlation:", round(rho, 3), "\n")
changes = strengths[
order(abs(strengths$Rank_Difference),
decreasing = TRUE), ]
knitr::kable(head(changes, 10), digits = 3)
plot(
strengths$Rank_Ordinary,
strengths$Rank_Ridge,
pch = 19,
col = rgb(0.2, 0.4, 0.8, 0.5),
xlab = "Ordinary Bradley-Terry Rank",
ylab = "Ridge Bradley-Terry Rank",
main = "Comparison of Team Strength Rankings"
)
abline(a = 0, b = 1, col = "red", lty = 2)
legend(
"topleft",
legend = paste("Spearman rho =", round(rho, 3)),
bty = "n"
)
