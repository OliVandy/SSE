}
}
get_min_effect_counts = function(effect_size, sample_size, threshold, a_t, b_t, a_c, b_c, quant = 0.5, s_reps = 10000, reps = 10000){
lambda_ctrl = rgamma(s_reps, a_c, rate = b_c)
probs = rep(NA, s_reps)
yt_vals = rep(NA, s_reps)
yc_vals = rep(NA, s_reps)
for(i in 1:s_reps){
ctrl_count = sum(rpois(sample_size, lambda_ctrl[i]))
treat_count = ctrl_count + floor(sample_size * effect_size)
probs[i] = simulate_post_prob(treat_count, ctrl_count, sample_size, threshold, a_t, b_t, a_c, b_c, quant = quant, simulations = reps)
yt_vals[i] = treat_count
yc_vals[i] = ctrl_count
}
min_index = which(probs == min(probs))[1]
return(list(y1 = yt_vals[min_index], y2 = yc_vals[min_index], min_xi = probs[min_index]))
}
calc_sample_for_count_data = function(threshold, crit, effect_size, a_t, b_t, a_c, b_c, min_n=5, max_n=100, quant = 0.5, s_reps = 1000, reps = 10000){
xi_vals = c()
diff_vals = c()
y1_vals = c()
y2_vals = c()
final_n = NA
final_diff = NA
print("Running sample size loop... please wait")
for(n in seq(min_n, max_n)){
if(n %% 10 == 0){
print(n)
}
min_result = get_min_effect_counts(effect_size, n, threshold, a_t, b_t, a_c, b_c, quant = quant, s_reps = s_reps, reps = reps)
xi_vals = c(xi_vals, min_result$min_xi)
diff_vals = c(diff_vals, min_result$y1 - min_result$y2)
y1_vals = c(y1_vals, min_result$y1)
y2_vals = c(y2_vals, min_result$y2)
if(min_result$min_xi >= crit && is.na(final_n)){
final_n = n
final_diff = min_result$y1 - min_result$y2
break
}
}
return(list(n = final_n, yd = final_diff, prob_h1_vec = xi_vals, yd_vec = diff_vals, y1_vec = y1_vals, y2_vec = y2_vals))
}
calc_sample_for_count_data(threshold = 1, crit = 0.95, effect_size = 1, a_t = 1, b_t = 1, a_c = 1, b_c = 1)
